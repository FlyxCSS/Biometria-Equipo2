<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- INTERNET: conexion con el servidor -->
    <uses-permission
        android:name="android.permission.INTERNET" />

    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Vibración corta al entrar en una zona con mala calidad del aire durante el recorrido -->
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- BIOMETRIA: Persona 2 -->
    <uses-permission
        android:name="android.permission.USE_BIOMETRIC" />

    <uses-permission
        android:name="android.permission.USE_FINGERPRINT" />

    <!-- UBICACION: Persona 1 y Persona 2 -->
    <uses-permission
        android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <uses-permission
        android:name="android.permission.ACCESS_FINE_LOCATION" />

    <!-- BLUETOOTH: Android 11 y anteriores -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_ADMIN"
        android:maxSdkVersion="30" />

    <!-- BLUETOOTH: Android 12 y posteriores -->
    <uses-permission
        android:name="android.permission.BLUETOOTH_SCAN" />

    <uses-permission
        android:name="android.permission.BLUETOOTH_CONNECT" />

    <!-- SERVICIO DE RECORRIDO: Persona 2 -->
    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE" />

    <uses-permission
        android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <!-- SENSOR BLE NECESARIO -->
    <uses-feature
        android:name="android.hardware.bluetooth_le"
        android:required="true" />

    <application
        android:name=".SendaApplication"
        android:allowBackup="false"
        android:usesCleartextTraffic="false"
        android:icon="@mipmap/ic_senda"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_senda_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.SENDA">

        <!-- PANTALLA INICIAL: PERSONA 2 -->
        <activity android:screenOrientation="portrait"
            android:name=".ui.WelcomeActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <activity android:screenOrientation="portrait" android:name=".auth.Login" android:windowSoftInputMode="adjustResize" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".auth.RecoveryActivity" android:windowSoftInputMode="adjustResize" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".auth.BiometricSetupActivity" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".ui.AccountActivity" android:windowSoftInputMode="adjustResize" android:exported="false" />
        <activity android:screenOrientation="portrait" android:name=".ui.PermissionsActivity" android:exported="false" />
        <!-- PANTALLAS DE PERSONA 2 -->
        <activity android:screenOrientation="portrait"
            android:name=".MainActivity"
            android:exported="false" />

        <activity android:screenOrientation="portrait"
            android:name=".routes.RouteActivity"
            android:exported="false" />

        <activity android:screenOrientation="portrait"
            android:name=".ui.SummaryActivity"
            android:exported="false" />

        <activity android:screenOrientation="portrait"
            android:name=".qr.QrScannerActivity"
            android:windowSoftInputMode="adjustResize"
            android:exported="false" />

        <!-- SERVICIO DE RECORRIDOS: PERSONA 2 -->
        <service
            android:name=".routes.RutaService"
            android:foregroundServiceType="location"
            android:exported="false" />

        <!-- PANTALLAS DE DIAGNOSTICO: PERSONA 1 -->
        <activity android:screenOrientation="portrait"
            android:name=".bluetooth.BleTestActivity"
            android:exported="false" />

        <activity android:screenOrientation="portrait"
            android:name=".qr.QrTestActivity"
            android:exported="false" />

        <activity android:screenOrientation="portrait"
            android:name=".integration.LlaveroFlowTestActivity"
            android:exported="false" />

        <provider android:name="androidx.core.content.FileProvider" android:authorities="${applicationId}.fotos" android:exported="false" android:grantUriPermissions="true">
            <meta-data android:name="android.support.FILE_PROVIDER_PATHS" android:resource="@xml/fotos_paths" />
        </provider>
    </application>

</manifest>
