<resources>
<style name="HomeText">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textColor">@color/senda_ink</item><item name="android:textSize">14sp</item>
</style>
<style name="HomeMapButton" parent="Widget.MaterialComponents.Button.TextButton">
<item name="android:layout_width">wrap_content</item><item name="android:layout_height">48dp</item>
<item name="android:minWidth">48dp</item><item name="android:textColor">@color/senda_ink</item>
<item name="android:textAllCaps">false</item><item name="android:textSize">15sp</item><item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item>
<item name="cornerRadius">24dp</item><item name="backgroundTint">#00FFFFFF</item>
<item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
<item name="android:insetLeft">0dp</item><item name="android:insetRight">0dp</item>
</style>
<style name="Chip">
<item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
<item name="android:paddingStart">12dp</item><item name="android:paddingEnd">14dp</item><item name="android:paddingTop">6dp</item><item name="android:paddingBottom">6dp</item>
<item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:background">@drawable/s_pill</item>
<item name="android:drawablePadding">6dp</item><item name="android:gravity">center_vertical</item><item name="android:singleLine">true</item>
</style>
<style name="OverlineText" parent="HomeText">
<item name="android:textSize">13sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item><item name="android:textColor">@color/senda_muted</item>
</style>
<style name="HomeNavigationIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
<item name="android:color">@color/senda_nav_indicator</item><item name="android:width">66dp</item><item name="android:height">52dp</item>
<item name="shapeAppearance">@style/NavIndicatorShape</item>
</style>
<style name="NavIndicatorShape"><item name="cornerFamily">rounded</item><item name="cornerSize">26dp</item></style>
<style name="NavLabel" parent="TextAppearance.Material3.LabelMedium"><item name="android:textSize">13sp</item><item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item></style>
<style name="NavLabelActive" parent="TextAppearance.Material3.LabelMedium"><item name="android:textSize">13sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item><item name="android:textFontWeight">700</item></style>
</resources>
