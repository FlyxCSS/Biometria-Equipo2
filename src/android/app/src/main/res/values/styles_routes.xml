<resources>
<style name="RoutePeriodButton" parent="HomeMapButton">
<item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item>
<item name="android:layout_height">44dp</item>
<item name="android:paddingStart">4dp</item><item name="android:paddingEnd">4dp</item>
<item name="android:textSize">16sp</item>
<item name="backgroundTint">@color/home_period_background</item><item name="android:textColor">@color/home_period_text</item>
<item name="strokeWidth">0dp</item><item name="cornerRadius">22dp</item>
</style>
<style name="SegmentGroup">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:background">@drawable/s_segment_track</item><item name="android:padding">4dp</item><item name="innerCornerSize">22dp</item>
</style>
<style name="RouteMetric">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textColor">@color/senda_ink</item><item name="android:textSize">18sp</item><item name="android:textStyle">bold</item><item name="android:textFontWeight">700</item>
<item name="android:singleLine">true</item><item name="android:autoSizeTextType">uniform</item><item name="android:autoSizeMinTextSize">12sp</item><item name="android:autoSizeMaxTextSize">18sp</item>
</style>
<style name="RouteMetricLabel" parent="HomeText"><item name="android:textSize">13sp</item><item name="android:textColor">@color/senda_muted</item></style>
</resources>
