<resources>
<style name="AuthLabel">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textColor">#1D4032</item><item name="android:textSize">16sp</item>
<item name="android:layout_marginBottom">8dp</item>
</style>
<style name="AuthButton" parent="Widget.MaterialComponents.Button">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">56dp</item><item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
<item name="android:textSize">18sp</item><item name="android:textStyle">bold</item>
<item name="android:textAllCaps">false</item><item name="android:textColor">#FFFFFF</item>
<item name="backgroundTint">#1D4032</item><item name="cornerRadius">24dp</item>
<item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
</style>
<style name="AuthEdit">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">56dp</item><item name="android:padding">16dp</item>
<item name="android:textSize">16sp</item><item name="android:textColor">#1D4032</item>
<item name="android:textColorHint">#718276</item><item name="android:singleLine">true</item>
<item name="android:background">@drawable/auth_input</item>
</style>
</resources>