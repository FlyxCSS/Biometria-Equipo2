<resources>
<style name="AuthLabel">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:textColor">@color/senda_muted</item><item name="android:textSize">14sp</item>
<item name="android:layout_marginBottom">8dp</item><item name="android:paddingStart">4dp</item>
</style>
<style name="AuthButton" parent="Widget.MaterialComponents.Button">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">56dp</item><item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
<item name="android:textSize">18sp</item><item name="android:textStyle">bold</item>
<item name="android:textAllCaps">false</item><item name="android:textColor">#FFFFFF</item>
<item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item><item name="android:textFontWeight">700</item>
<item name="backgroundTint">@color/senda_ink</item><item name="cornerRadius">20dp</item>
<item name="iconTint">#FFFFFF</item><item name="iconGravity">textStart</item><item name="iconPadding">14dp</item><item name="iconSize">22dp</item>
<item name="android:insetTop">0dp</item><item name="android:insetBottom">0dp</item>
<item name="android:stateListAnimator">@null</item>
</style>
<style name="MintButton" parent="AuthButton">
<item name="backgroundTint">@color/senda_mint</item><item name="android:textColor">@color/senda_ink</item><item name="iconTint">@color/senda_ink</item>
</style>
<style name="DangerButton" parent="AuthButton">
<item name="backgroundTint">@color/status_error_strong</item>
</style>
<style name="OutlineButton" parent="AuthButton">
<item name="backgroundTint">#FFFFFF</item><item name="android:textColor">@color/senda_ink</item><item name="iconTint">@color/senda_ink</item>
<item name="strokeColor">@color/senda_stroke</item><item name="strokeWidth">1dp</item>
</style>
<style name="LinkButton" parent="Widget.Material3.Button.TextButton">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">48dp</item><item name="android:textAllCaps">false</item><item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item>
<item name="android:textColor">@color/senda_ink</item><item name="android:textSize">16sp</item><item name="android:textStyle">bold</item>
</style>
<style name="AuthEdit">
<item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
<item name="android:minHeight">54dp</item><item name="android:paddingStart">18dp</item><item name="android:paddingEnd">18dp</item>
<item name="android:paddingTop">14dp</item><item name="android:paddingBottom">14dp</item>
<item name="android:textSize">17sp</item><item name="android:textColor">@color/senda_ink</item>
<item name="android:textColorHint">@color/senda_hint</item><item name="android:singleLine">true</item>
<item name="android:background">@drawable/s_input</item>
</style>
</resources>
