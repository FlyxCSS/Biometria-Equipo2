<resources>
    <style name="SendaSectionText" parent="TextAppearance.Material3.BodyLarge">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:textColor">@color/senda_text</item>
        <item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item>
    </style>
    <style name="SendaSectionLabel" parent="SendaSectionText">
        <item name="android:textStyle">bold</item>
    </style>
    <style name="SendaSectionTitle" parent="SendaSectionLabel">
        <item name="android:textSize">26sp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>
    <style name="SendaSectionButton" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/senda_ink</item>
        <item name="strokeColor">@color/senda_stroke</item>
        <item name="cornerRadius">16dp</item><item name="android:letterSpacing">0</item><item name="android:fontFamily">@font/inter</item><item name="fontFamily">@font/inter</item>
    </style>
    <style name="SectionHeader">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">14sp</item><item name="android:textStyle">bold</item><item name="android:letterSpacing">0.08</item>
        <item name="android:textColor">@color/senda_muted</item><item name="android:paddingStart">4dp</item>
        <item name="android:paddingTop">8dp</item><item name="android:paddingBottom">10dp</item>
    </style>
</resources>
