<resources>
    <style name="KeyringCard" parent="AccountCard">
        <item name="android:padding">16dp</item><item name="android:layout_marginBottom">14dp</item>
    </style>
    <style name="KeyringValue" parent="SendaSectionText">
        <item name="android:textSize">16sp</item><item name="android:paddingTop">16dp</item>
        <item name="android:paddingBottom">16dp</item>
    </style>
    <style name="KeyringRowLabel">
        <item name="android:layout_width">wrap_content</item><item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">17sp</item><item name="android:textColor">@color/senda_ink</item>
    </style>
    <style name="KeyringRowValue">
        <item name="android:layout_width">0dp</item><item name="android:layout_weight">1</item><item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item><item name="android:gravity">end</item>
        <item name="android:textSize">16sp</item><item name="android:textColor">@color/senda_muted</item>
    </style>
    <style name="KeyringRow">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item><item name="android:gravity">center_vertical</item>
        <item name="android:paddingTop">12dp</item><item name="android:paddingBottom">12dp</item>
    </style>
    <style name="KeyringDivider">
        <item name="android:layout_width">match_parent</item><item name="android:layout_height">1dp</item>
        <item name="android:background">@color/senda_divider</item>
    </style>
</resources>
