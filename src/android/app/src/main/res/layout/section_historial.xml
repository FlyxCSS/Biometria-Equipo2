<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView style="@style/AccountTitle" android:text="Historial"/>
<TextView style="@style/AccountSubtitle" android:text="El aire que has recorrido"/>
<View style="@style/AccountDivider"/>
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/history_source" android:layout_width="match_parent" android:layout_height="wrap_content" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/history_phone">
<com.google.android.material.button.MaterialButton android:id="@+id/history_phone" style="@style/RoutePeriodButton" android:text="Este móvil"/>
<com.google.android.material.button.MaterialButton android:id="@+id/history_account" style="@style/RoutePeriodButton" android:text="Mi cuenta"/>
</com.google.android.material.button.MaterialButtonToggleGroup>
<TextView android:id="@+id/history_hint" style="@style/SendaSectionText" android:layout_marginTop="16dp" android:text="Lecturas guardadas en este móvil, incluidas las pendientes de envío."/>
<com.google.android.material.button.MaterialButton android:id="@+id/button_refresh_history" style="@style/SendaSectionButton" android:text="Actualizar historial"/>
<ProgressBar android:id="@+id/history_loading" android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:visibility="gone" android:contentDescription="Cargando historial"/>
<TextView android:id="@+id/text_list_empty" style="@style/AccountDetail" android:layout_marginTop="20dp" android:text="Todavía no hay lecturas. Vincula tu llavero y comienza un recorrido para registrar el aire de tu entorno." android:accessibilityLiveRegion="polite"/>
<LinearLayout android:id="@+id/list_history" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"/>
<TextView android:id="@+id/page_number" style="@style/SendaSectionText" android:gravity="center"/>
<LinearLayout android:id="@+id/history_pages" android:layout_width="match_parent" android:layout_height="wrap_content">
<com.google.android.material.button.MaterialButton android:id="@+id/button_previous" style="@style/SendaSectionButton" android:layout_width="0dp" android:layout_weight="1" android:text="Anterior"/>
<com.google.android.material.button.MaterialButton android:id="@+id/button_next" style="@style/SendaSectionButton" android:layout_width="0dp" android:layout_weight="1" android:text="Siguiente"/>
</LinearLayout></LinearLayout>