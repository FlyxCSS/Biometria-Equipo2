<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView style="@style/SendaSectionTitle" android:text="@string/main_mas" />
    <TextView android:id="@+id/text_account" style="@style/SendaSectionText" />
    <TextView android:id="@+id/text_permissions" style="@style/SendaSectionText" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_permissions" style="@style/SendaSectionButton" android:text="@string/main_permissions" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_settings" style="@style/SendaSectionButton" android:text="@string/main_settings" />
    <TextView style="@style/SendaSectionLabel" android:text="@string/main_sync" />
    <TextView android:id="@+id/text_sync" style="@style/SendaSectionText" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_retry_sync" style="@style/SendaSectionButton" android:text="@string/main_retry" />
    <com.google.android.material.button.MaterialButton android:id="@+id/button_logout" style="@style/SendaSectionButton" android:text="@string/main_logout" />
</LinearLayout>
