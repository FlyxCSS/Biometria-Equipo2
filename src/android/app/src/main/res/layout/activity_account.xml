<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/account_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/senda_surface" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="20dp" android:orientation="vertical">
<!-- Cabecera: volver a la izquierda y guardar (tick verde) a la derecha, a la misma altura -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:gravity="center_vertical">
<com.google.android.material.button.MaterialButton android:id="@+id/account_back" style="@style/SendaBack" android:layout_marginTop="8dp" android:contentDescription="Volver a Ajustes"/>
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<com.google.android.material.button.MaterialButton android:id="@+id/profile_save" style="@style/SendaBack" android:layout_marginTop="8dp" android:contentDescription="Guardar cambios" android:tooltipText="Guardar cambios" app:backgroundTint="@color/senda_mint" app:icon="@drawable/ic_s_check_circle" app:iconTint="@color/senda_ink" app:iconSize="26dp"/>
</LinearLayout>
<TextView style="@style/AccountTitle" android:paddingTop="10dp" android:text="Perfil"/>
<TextView style="@style/AccountSubtitle" android:text="@string/account_profile_subtitle"/>

<FrameLayout android:layout_width="108dp" android:layout_height="108dp" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp">
<com.google.android.material.imageview.ShapeableImageView android:id="@+id/profile_photo" android:layout_width="104dp" android:layout_height="104dp" android:src="@drawable/account_avatar" android:scaleType="centerCrop" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/AccountAvatarShape"/>
<TextView android:id="@+id/profile_initials" android:layout_width="104dp" android:layout_height="104dp" android:gravity="center" android:textColor="#FFFFFF" android:textSize="38sp" android:textStyle="bold" android:importantForAccessibility="no"/>
<ImageView android:id="@+id/profile_camera" android:layout_width="40dp" android:layout_height="40dp" android:layout_gravity="bottom|end" android:background="@drawable/s_circle_white" android:foreground="?attr/selectableItemBackgroundBorderless" android:elevation="2dp" android:padding="9dp" android:src="@drawable/ic_s_camera" android:clickable="true" android:focusable="true" android:contentDescription="Hacer una foto de perfil con la cámara"/>
</FrameLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/profile_change_photo" style="@style/LinkButton" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:textStyle="normal" android:textSize="17sp" android:text="@string/account_photo"/>
<com.google.android.material.button.MaterialButton android:id="@+id/profile_remove_photo" style="@style/LinkButton" android:layout_width="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="-8dp" android:minHeight="40dp" android:textSize="14sp" android:textStyle="normal" android:text="Eliminar foto" android:textColor="@color/status_error"/>

<LinearLayout style="@style/AccountCard" android:layout_marginTop="8dp" android:paddingTop="4dp" android:paddingBottom="4dp">
<TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:labelFor="@id/profile_name" android:text="@string/account_name"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<EditText android:id="@+id/profile_name" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:textSize="18sp" android:textColor="@color/senda_ink" android:inputType="textPersonName" android:maxLength="100" android:autofillHints="name"/>
<ImageView android:id="@+id/profile_name_edit" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_s_edit" app:tint="@color/senda_muted" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Editar"/>
</LinearLayout>
<View style="@style/AccountDivider"/>
<TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:text="@string/account_email"/>
<TextView android:id="@+id/profile_email" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:textSize="18sp" android:textColor="@color/senda_ink" android:textIsSelectable="true"/>
<View style="@style/AccountDivider"/>
<TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:labelFor="@id/profile_phone" android:text="@string/account_phone"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<EditText android:id="@+id/profile_phone" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:textSize="18sp" android:textColor="@color/senda_ink" android:textColorHint="@color/senda_hint" android:inputType="phone" android:maxLength="24" android:autofillHints="phone" android:hint="+34 600 000 000"/>
<ImageView android:id="@+id/profile_phone_edit" android:layout_width="40dp" android:layout_height="40dp" android:padding="9dp" android:src="@drawable/ic_s_edit" app:tint="@color/senda_muted" android:background="?attr/selectableItemBackgroundBorderless" android:clickable="true" android:focusable="true" android:contentDescription="Editar"/>
</LinearLayout>
<View style="@style/AccountDivider"/>
<TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:text="@string/account_park"/>
<TextView android:id="@+id/profile_park" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:gravity="center_vertical" android:textSize="18sp" android:textColor="@color/senda_ink" android:paddingBottom="6dp"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/account_local_note" android:textSize="13sp" android:textColor="@color/senda_muted" android:paddingStart="4dp" android:paddingEnd="4dp"/>
<View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp"/>
<TextView android:id="@+id/profile_feedback" style="@style/SendaSectionText" android:gravity="center" android:textColor="@color/senda_muted" android:accessibilityLiveRegion="polite"/>
</LinearLayout></ScrollView>
