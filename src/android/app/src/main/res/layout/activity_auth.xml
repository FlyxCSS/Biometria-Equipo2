<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/senda_surface">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/senda_forest" android:scaleType="fitEnd" android:importantForAccessibility="no"/>
<ScrollView android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingBottom="28dp">
<TextView android:id="@+id/auth_back" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="80dp" android:gravity="center_vertical" android:text="@string/auth_back" android:textSize="18sp" android:textStyle="bold" android:textColor="@color/senda_ink" android:background="?attr/selectableItemBackground" android:visibility="gone"/>
<LinearLayout android:id="@+id/auth_hero" android:layout_width="match_parent" android:layout_height="214dp" android:orientation="vertical" android:gravity="center">
<ImageView android:id="@+id/auth_emblem" android:layout_width="92dp" android:layout_height="106dp" android:src="@drawable/senda_logo" android:scaleType="fitCenter" android:contentDescription="SENDA"/>
<TextView android:id="@+id/auth_brand" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="26dp" android:paddingBottom="20dp" android:background="@drawable/s_card" android:elevation="2dp">
<TextView android:id="@+id/auth_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="@string/auth_title" android:textSize="27sp" android:textStyle="bold" android:letterSpacing="-0.02" android:textFontWeight="800" android:fontFamily="@font/inter_heavy" app:fontFamily="@font/inter_heavy" android:textColor="@color/senda_ink"/>
<TextView android:id="@+id/auth_subtitle" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Introduce tus datos de trabajador" android:textSize="15sp" android:textColor="@color/senda_muted" android:layout_marginTop="2dp" android:layout_marginBottom="20dp"/>
<TextView android:id="@+id/auth_description" style="@style/AuthLabel" android:text="@string/auth_recovery_description" android:gravity="center" android:layout_marginBottom="16dp" android:visibility="gone"/>
<TextView style="@style/AuthLabel" android:text="@string/auth_email" android:labelFor="@id/auth_email"/>
<EditText android:id="@+id/auth_email" style="@style/AuthEdit" android:hint="@string/auth_email_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext"/>
<LinearLayout android:id="@+id/auth_password_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="18dp">
<TextView style="@style/AuthLabel" android:text="@string/auth_password" android:labelFor="@id/auth_password"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_password" style="@style/AuthEdit" android:background="@android:color/transparent" android:hint="@string/auth_password" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" android:saveEnabled="false"/>
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<TextView android:id="@+id/auth_forgot" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:minHeight="48dp" android:paddingStart="8dp" android:paddingEnd="2dp" android:gravity="center_vertical" android:text="@string/auth_forgot" android:textColor="@color/senda_ink" android:textSize="15sp" android:background="?attr/selectableItemBackground"/>
<TextView android:id="@+id/auth_feedback" style="@style/AuthLabel" android:textColor="@color/status_error" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
<ProgressBar android:id="@+id/auth_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:layout_margin="8dp" android:indeterminateTint="@color/senda_ink" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" style="@style/AuthButton" android:text="@string/auth_login" android:layout_marginTop="4dp"/>
<LinearLayout android:id="@+id/auth_biometric_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="14dp" android:layout_marginBottom="14dp" android:importantForAccessibility="noHideDescendants">
<View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:background="@color/senda_divider"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="o" android:textColor="@color/senda_muted" android:textSize="15sp" android:paddingHorizontal="20dp"/>
<View android:layout_width="0dp" android:layout_weight="1" android:layout_height="1dp" android:background="@color/senda_divider"/>
</LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/auth_biometric" style="@style/OutlineButton" android:text="@string/auth_biometric" app:icon="@drawable/ic_s_fingerprint"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</ScrollView>
</FrameLayout>
