<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/auth_landscape">
<ScrollView android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="24dp" android:paddingEnd="24dp" android:paddingBottom="28dp">
<TextView android:id="@+id/auth_back" android:layout_width="wrap_content" android:layout_height="48dp" android:minWidth="80dp" android:gravity="center_vertical" android:text="@string/auth_back" android:textSize="20sp" android:textStyle="bold" android:textColor="#1D4032" android:background="?attr/selectableItemBackground" android:visibility="gone"/>
<LinearLayout android:id="@+id/auth_hero" android:layout_width="match_parent" android:layout_height="230dp" android:orientation="vertical" android:gravity="center">
<ImageView android:id="@+id/auth_emblem" android:layout_width="128dp" android:layout_height="121dp" android:src="@drawable/auth_logo" android:importantForAccessibility="no"/>
<TextView android:id="@+id/auth_brand" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="S E N D A" android:textSize="30sp" android:textStyle="bold" android:textColor="#1D4032" android:layout_marginTop="8dp"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp" android:background="@drawable/auth_card">
<TextView android:id="@+id/auth_title" style="@style/AuthLabel" android:text="@string/auth_title" android:textSize="25sp" android:textStyle="bold" android:gravity="center" android:layout_marginTop="12dp" android:layout_marginBottom="24dp"/>
<TextView android:id="@+id/auth_description" style="@style/AuthLabel" android:text="@string/auth_recovery_description" android:textColor="#536A5B" android:gravity="center" android:layout_marginBottom="24dp" android:visibility="gone"/>
<TextView style="@style/AuthLabel" android:text="@string/auth_email" android:labelFor="@id/auth_email"/>
<EditText android:id="@+id/auth_email" style="@style/AuthEdit" android:hint="@string/auth_email_hint" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:imeOptions="actionNext"/>
<LinearLayout android:id="@+id/auth_password_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginTop="20dp">
<TextView style="@style/AuthLabel" android:text="@string/auth_password" android:labelFor="@id/auth_password"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/auth_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="#718276">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/auth_password" style="@style/AuthEdit" android:background="@android:color/transparent" android:hint="@string/auth_password_hint" android:inputType="textPassword" android:autofillHints="password" android:imeOptions="actionDone" android:saveEnabled="false"/>
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<TextView android:id="@+id/auth_forgot" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="48dp" android:padding="8dp" android:gravity="center" android:text="@string/auth_forgot" android:textColor="#1D4032" android:textSize="15sp" android:background="?attr/selectableItemBackground"/>
<TextView android:id="@+id/auth_feedback" style="@style/AuthLabel" android:textColor="#953E22" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
<ProgressBar android:id="@+id/auth_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:layout_margin="8dp" android:indeterminateTint="#1D4032" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" style="@style/AuthButton" android:text="@string/auth_login" android:layout_marginTop="12dp"/>
<LinearLayout android:id="@+id/auth_biometric_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView style="@style/AuthLabel" android:text="─────────   o   ─────────" android:gravity="center" android:layout_marginTop="16dp" android:layout_marginBottom="16dp" android:importantForAccessibility="no"/>
<com.google.android.material.button.MaterialButton android:id="@+id/auth_biometric" style="@style/AuthButton" android:text="@string/auth_biometric" android:textColor="#1D4032" app:backgroundTint="#D7E0CE"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</ScrollView>
</FrameLayout>