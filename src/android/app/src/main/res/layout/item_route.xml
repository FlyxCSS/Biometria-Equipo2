<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:padding="12dp" android:gravity="center_vertical">
<com.example.ozora.senda.ui.RoutePreviewView android:id="@+id/route_preview" android:layout_width="76dp" android:layout_height="84dp" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView android:id="@+id/route_name" style="@style/HomeText" android:layout_width="0dp" android:layout_weight="1" android:textSize="11sp" android:textStyle="bold" android:textColor="#718276"/>
<TextView android:id="@+id/route_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/routes_in_progress" android:textSize="10sp" android:textColor="#1D4032" android:background="@drawable/home_card" android:padding="5dp" android:visibility="gone"/>
</LinearLayout>
<TextView android:id="@+id/route_date" style="@style/HomeText" android:textSize="12sp" android:layout_marginTop="8dp" android:layout_marginBottom="10dp"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
