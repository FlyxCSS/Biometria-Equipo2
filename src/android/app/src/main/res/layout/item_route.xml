<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="12dp" android:paddingEnd="14dp" android:paddingTop="12dp" android:paddingBottom="12dp" android:gravity="center_vertical">
<com.example.ozora.senda.ui.RoutePreviewView android:id="@+id/route_preview" android:layout_width="84dp" android:layout_height="84dp" android:importantForAccessibility="no"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/route_name" style="@style/HomeText" android:textSize="16sp" android:singleLine="true" android:ellipsize="end"/>
<TextView android:id="@+id/route_date" style="@style/HomeText" android:textSize="14sp" android:textColor="@color/senda_muted" android:layout_marginTop="1dp"/>
</LinearLayout>
<TextView android:id="@+id/route_status" style="@style/Chip" android:text="@string/routes_in_progress" android:textSize="13sp" android:textColor="@color/senda_ink" android:backgroundTint="@color/status_success_surface" android:drawableStart="@drawable/ic_s_dot" android:drawableTint="@color/status_success" android:visibility="gone"/>
<ImageView android:id="@+id/route_chevron" style="@style/SettingsChevron"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:baselineAligned="false">
<LinearLayout android:layout_width="0dp" android:layout_weight="1.3" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/route_duration" style="@style/RouteMetric"/><TextView style="@style/RouteMetricLabel" android:text="@string/routes_duration"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
<TextView android:id="@+id/route_distance" style="@style/RouteMetric"/><TextView style="@style/RouteMetricLabel" android:text="@string/routes_distance"/>
</LinearLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="6dp" android:orientation="vertical">
<TextView android:id="@+id/route_count" style="@style/RouteMetric"/><TextView style="@style/RouteMetricLabel" android:text="@string/routes_measurements"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>
</LinearLayout>
