<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/security_root" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true" android:background="@color/senda_surface">
<LinearLayout android:id="@+id/security_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp" android:paddingBottom="20dp" android:orientation="vertical">
    <com.google.android.material.button.MaterialButton android:id="@+id/security_back" style="@style/SendaBack" android:layout_marginTop="24dp" android:contentDescription="Volver a Ajustes"/>
    <TextView style="@style/AccountTitle" android:paddingTop="10dp" android:text="Contraseña"/>
    <TextView style="@style/AccountSubtitle" android:text="Cuida el acceso a tu cuenta"/>

    <!-- Mismo estilo que Gestionar perfil: etiqueta gris + campo sin borde, separados por líneas -->
    <LinearLayout style="@style/AccountCard" android:paddingTop="4dp" android:paddingBottom="4dp">
        <TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:labelFor="@id/security_current" android:text="Contraseña actual"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/security_current" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:paddingStart="0dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="18sp" android:textColor="@color/senda_ink" android:textColorHint="@color/senda_hint" android:hint="••••••••••••" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:autofillHints="password" android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>
        <View style="@style/AccountDivider"/>
        <TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:labelFor="@id/security_next" android:text="Nueva contraseña"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/security_next" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:paddingStart="0dp" android:paddingTop="6dp" android:paddingBottom="6dp" android:textSize="18sp" android:textColor="@color/senda_ink" android:textColorHint="@color/senda_hint" android:hint="Mínimo 12 caracteres" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:autofillHints="newPassword" android:imeOptions="actionNext"/>
        </com.google.android.material.textfield.TextInputLayout>
        <View style="@style/AccountDivider"/>
        <TextView style="@style/AuthLabel" android:paddingStart="0dp" android:layout_marginTop="12dp" android:layout_marginBottom="0dp" android:labelFor="@id/security_confirm" android:text="Repetir nueva contraseña"/>
        <com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
            <com.google.android.material.textfield.TextInputEditText android:id="@+id/security_confirm" android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="44dp" android:background="@null" android:paddingStart="0dp" android:paddingTop="6dp" android:paddingBottom="10dp" android:textSize="18sp" android:textColor="@color/senda_ink" android:textColorHint="@color/senda_hint" android:hint="Repite la nueva contraseña" android:inputType="textPassword" android:singleLine="true" android:saveEnabled="false" android:autofillHints="newPassword" android:imeOptions="actionDone"/>
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
    <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="4dp" android:paddingEnd="4dp" android:textSize="13sp" android:textColor="@color/senda_muted" android:text="Usa entre 12 y 72 bytes (los acentos y símbolos ocupan más) y que sea distinta de la actual. Al guardar se cerrarán las sesiones de tu cuenta; podrás volver a activar la biometría tras entrar con la nueva contraseña."/>
    <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="24dp"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/security_submit" style="@style/MintButton" android:text="Actualizar contraseña" android:tag="submit" app:icon="@drawable/ic_s_check_circle"/>
</LinearLayout></ScrollView>
