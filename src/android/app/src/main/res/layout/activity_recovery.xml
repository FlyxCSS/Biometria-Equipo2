<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/senda_surface">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/senda_forest" android:scaleType="fitEnd" android:importantForAccessibility="no"/>
<ScrollView android:id="@+id/auth_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="28dp">
<com.google.android.material.button.MaterialButton android:id="@+id/auth_back" style="@style/SendaBack" android:layout_marginTop="40dp" android:contentDescription="Volver"/>
<TextView android:id="@+id/auth_title" android:layout_width="0dp" android:layout_height="0dp" android:visibility="gone" android:text="@string/auth_recovery_title"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="28dp" android:paddingBottom="20dp" android:background="@drawable/s_card" android:elevation="2dp">
<FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="18dp" android:background="@drawable/s_circle_tile">
<ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_s_mail" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/recovery_question" style="@style/FlowHeadline" android:text="@string/recovery_question"/>
<TextView android:id="@+id/recovery_description" style="@style/FlowDescription" android:text="@string/recovery_description"/>
<LinearLayout android:id="@+id/recovery_email_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView style="@style/AuthLabel" android:text="@string/auth_email" android:labelFor="@id/auth_email"/>
<EditText android:id="@+id/auth_email" style="@style/AuthEdit" android:inputType="textEmailAddress" android:autofillHints="emailAddress" android:hint="@string/auth_email_hint" android:imeOptions="actionSend"/>
</LinearLayout>
<LinearLayout android:id="@+id/recovery_link_group" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<TextView style="@style/AuthLabel" android:text="@string/recovery_link_label" android:labelFor="@id/recovery_token"/>
<EditText android:id="@+id/recovery_token" style="@style/AuthEdit" android:inputType="textVisiblePassword|textNoSuggestions" android:hint="@string/recovery_link_hint" android:saveEnabled="false" android:importantForAutofill="no" android:imeOptions="actionNext"/>
<TextView style="@style/AuthLabel" android:text="@string/recovery_password" android:layout_marginTop="16dp" android:labelFor="@id/recovery_password"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/recovery_password" style="@style/AuthEdit" android:background="@android:color/transparent" android:inputType="textPassword" android:saveEnabled="false" android:autofillHints="newPassword" android:imeOptions="actionNext"/>
</com.google.android.material.textfield.TextInputLayout>
<TextView style="@style/AuthLabel" android:text="@string/recovery_repeat" android:layout_marginTop="16dp" android:labelFor="@id/recovery_repeat"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconDrawable="@drawable/ic_s_eye" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/recovery_repeat" style="@style/AuthEdit" android:background="@android:color/transparent" android:inputType="textPassword" android:saveEnabled="false" android:autofillHints="newPassword" android:imeOptions="actionDone"/>
</com.google.android.material.textfield.TextInputLayout>
</LinearLayout>
<TextView android:id="@+id/auth_feedback" style="@style/AuthLabel" android:paddingTop="12dp" android:gravity="center" android:accessibilityLiveRegion="polite" android:visibility="gone"/>
<ProgressBar android:id="@+id/auth_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:layout_margin="8dp" android:indeterminateTint="@color/senda_ink" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/auth_submit" style="@style/MintButton" android:text="@string/auth_send" android:layout_marginTop="18dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/recovery_existing_link" style="@style/FlowSecondary" android:textSize="15sp" android:text="@string/recovery_link_label"/>
</LinearLayout></LinearLayout></ScrollView></FrameLayout>
