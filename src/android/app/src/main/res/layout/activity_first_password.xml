<!-- Primer acceso: el trabajador cambia la contraseña inicial que le asignó el jefe de parque.
     Misma estética que el resto del acceso (bosque, tarjeta blanca, campos y botón menta). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/senda_surface">
<ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/senda_forest" android:scaleType="fitEnd" android:importantForAccessibility="no"/>
<ScrollView android:id="@+id/inicial_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingHorizontal="16dp" android:paddingBottom="28dp">
<com.google.android.material.button.MaterialButton android:id="@+id/inicial_volver" style="@style/SendaBack" android:layout_marginTop="40dp" android:contentDescription="Volver al acceso"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="28dp" android:paddingBottom="20dp" android:background="@drawable/s_card" android:elevation="2dp">
<FrameLayout android:layout_width="72dp" android:layout_height="72dp" android:layout_gravity="center_horizontal" android:layout_marginBottom="18dp" android:background="@drawable/s_circle_tile">
<ImageView android:layout_width="32dp" android:layout_height="32dp" android:layout_gravity="center" android:src="@drawable/ic_s_lock" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView style="@style/FlowHeadline" android:text="Crea tu contraseña"/>
<TextView style="@style/FlowDescription" android:text="Es tu primer acceso. Cambia la contraseña inicial que te dio tu responsable por una propia de al menos 12 caracteres."/>
<TextView style="@style/AuthLabel" android:text="Contraseña inicial" android:labelFor="@id/inicial_actual"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/inicial_actual" style="@style/AuthEdit" android:background="@android:color/transparent" android:hint="La que te dio tu responsable" android:inputType="textPassword" android:autofillHints="password" android:saveEnabled="false" android:imeOptions="actionNext"/>
</com.google.android.material.textfield.TextInputLayout>
<TextView style="@style/AuthLabel" android:text="Nueva contraseña" android:layout_marginTop="16dp" android:labelFor="@id/inicial_nueva"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/inicial_nueva" style="@style/AuthEdit" android:background="@android:color/transparent" android:hint="Mínimo 12 caracteres" android:inputType="textPassword" android:autofillHints="newPassword" android:saveEnabled="false" android:imeOptions="actionNext"/>
</com.google.android.material.textfield.TextInputLayout>
<TextView style="@style/AuthLabel" android:text="Repetir nueva contraseña" android:layout_marginTop="16dp" android:labelFor="@id/inicial_repetir"/>
<com.google.android.material.textfield.TextInputLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/s_input" app:boxBackgroundMode="none" app:hintEnabled="false" app:endIconMode="password_toggle" app:endIconTint="@color/senda_muted">
<com.google.android.material.textfield.TextInputEditText android:id="@+id/inicial_repetir" style="@style/AuthEdit" android:background="@android:color/transparent" android:hint="Repite la nueva contraseña" android:inputType="textPassword" android:autofillHints="newPassword" android:saveEnabled="false" android:imeOptions="actionDone"/>
</com.google.android.material.textfield.TextInputLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:paddingStart="4dp" android:paddingEnd="4dp" android:text="Mínimo 12 caracteres, con mayúscula, minúscula, número y símbolo (! ? # . -). Debe ser distinta de la inicial y no contener tu nombre ni secuencias como 1234." android:textSize="13sp" android:textColor="@color/senda_muted"/>
<ProgressBar android:id="@+id/inicial_progreso" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center" android:layout_marginTop="12dp" android:indeterminateTint="@color/senda_ink" android:visibility="gone"/>
<com.google.android.material.button.MaterialButton android:id="@+id/inicial_guardar" style="@style/MintButton" android:layout_marginTop="18dp" android:text="Guardar contraseña" app:icon="@drawable/ic_s_check_circle"/>
<com.google.android.material.button.MaterialButton android:id="@+id/inicial_cancelar" style="@style/FlowSecondary" android:textSize="15sp" android:text="Volver al acceso"/>
</LinearLayout></LinearLayout></ScrollView></FrameLayout>
