<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
android:id="@+id/main_root" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/senda_surface" android:orientation="vertical">
<FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
<FrameLayout android:id="@+id/home_host" android:layout_width="match_parent" android:layout_height="match_parent" android:visibility="gone"/>
<ScrollView android:id="@+id/main_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
<LinearLayout android:id="@+id/main_content" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<FrameLayout android:id="@+id/section_host" android:layout_width="match_parent" android:layout_height="wrap_content"/>
</LinearLayout>
</ScrollView>
</FrameLayout>
<TextView android:id="@+id/main_feedback" style="@style/SendaSectionText" android:paddingStart="16dp" android:paddingEnd="16dp" android:visibility="gone" android:accessibilityLiveRegion="polite"/>
<com.google.android.material.bottomnavigation.BottomNavigationView android:id="@+id/bottom_navigation" android:layout_width="match_parent" android:layout_height="wrap_content" android:background="@drawable/home_card" app:itemIconTint="#1D4032" app:itemTextColor="#1D4032" app:itemActiveIndicatorStyle="@style/HomeNavigationIndicator" app:itemHorizontalTranslationEnabled="false" app:labelVisibilityMode="labeled" app:menu="@menu/main_navigation"/>
</LinearLayout>