<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="8dp">
<TextView style="@style/AccountTitle" android:text="@string/keyring_title"/>
<TextView style="@style/AccountSubtitle" android:text="Tu conexión con el entorno"/>

<LinearLayout style="@style/KeyringCard" android:gravity="center_horizontal" android:paddingTop="22dp" android:paddingBottom="22dp">
<FrameLayout android:id="@+id/keyring_halo" android:layout_width="112dp" android:layout_height="112dp" android:background="@drawable/s_circle_tile">
<ImageView android:id="@+id/keyring_image" android:layout_width="66dp" android:layout_height="86dp" android:layout_gravity="center" android:src="@drawable/senda_keyring" android:scaleType="fitCenter" android:importantForAccessibility="no"/>
</FrameLayout>
<TextView android:id="@+id/keyring_status" style="@style/Chip" android:layout_marginTop="12dp" android:drawableStart="@drawable/ic_s_dot_ring" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/keyring_id" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:gravity="center" android:textSize="30sp" android:textStyle="bold" android:textColor="@color/senda_ink" android:breakStrategy="simple" android:textFontWeight="800" android:fontFamily="@font/inter_heavy" app:fontFamily="@font/inter_heavy"/>
<TextView android:id="@+id/keyring_park" android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:textSize="16sp" android:textColor="@color/senda_muted"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
<LinearLayout style="@style/KeyringCard" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="7dp" android:minHeight="104dp">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<ImageView android:id="@+id/keyring_ble_icon" style="@style/SettingsIcon" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:src="@drawable/ic_s_bluetooth"/>
<View android:layout_width="0dp" android:layout_height="1dp" android:layout_weight="1"/>
<View android:id="@+id/keyring_ble_dot" android:layout_width="10dp" android:layout_height="10dp" android:background="@drawable/s_circle_ink"/>
</LinearLayout>
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:text="Señal BLE" android:textSize="14sp" android:textColor="@color/senda_muted"/>
<TextView android:id="@+id/keyring_reception" android:layout_width="match_parent" android:layout_height="wrap_content" android:textStyle="bold" android:textSize="19sp" android:singleLine="true"/>
</LinearLayout>
<LinearLayout style="@style/KeyringCard" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="7dp" android:minHeight="104dp">
<ImageView style="@style/SettingsIcon" android:layout_width="30dp" android:layout_height="30dp" android:padding="6dp" android:background="@drawable/s_tile" android:backgroundTint="@color/senda_tile_neutral" android:src="@drawable/ic_s_battery"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:gravity="center_vertical">
<TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="@string/keyring_battery" android:textSize="14sp" android:textColor="@color/senda_muted"/>
<TextView android:id="@+id/keyring_battery_value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="—" android:textSize="19sp" android:textStyle="bold" android:textColor="@color/senda_ink" android:contentDescription="Batería no disponible"/>
</LinearLayout>
<FrameLayout android:layout_width="match_parent" android:layout_height="6dp" android:layout_marginTop="8dp" android:background="@drawable/s_progress_track"><View android:id="@+id/keyring_battery_bar" android:layout_width="0dp" android:layout_height="match_parent" android:background="@drawable/s_pill" android:visibility="invisible"/></FrameLayout>
</LinearLayout></LinearLayout>

<LinearLayout android:id="@+id/keyring_details" style="@style/KeyringCard" android:paddingTop="4dp" android:paddingBottom="4dp">
<LinearLayout style="@style/KeyringRow"><TextView style="@style/KeyringRowLabel" android:text="Estado"/><TextView android:id="@+id/text_device" style="@style/KeyringRowValue"/></LinearLayout>
<View style="@style/KeyringDivider"/>
<LinearLayout style="@style/KeyringRow"><TextView style="@style/KeyringRowLabel" android:text="Última lectura"/><TextView android:id="@+id/text_last_o3" style="@style/KeyringRowValue"/></LinearLayout>
<View style="@style/KeyringDivider"/>
<LinearLayout style="@style/KeyringRow"><TextView style="@style/KeyringRowLabel" android:text="Temperatura"/><TextView android:id="@+id/keyring_temperature_value" style="@style/KeyringRowValue"/></LinearLayout>
<View style="@style/KeyringDivider"/>
<LinearLayout style="@style/KeyringRow"><TextView style="@style/KeyringRowLabel" android:text="Vinculado el"/><TextView android:id="@+id/keyring_link_date" style="@style/KeyringRowValue"/></LinearLayout>
<View style="@style/KeyringDivider"/>
<LinearLayout style="@style/KeyringRow"><TextView style="@style/KeyringRowLabel" android:text="Firmware"/><TextView style="@style/KeyringRowValue" android:text="No disponible"/></LinearLayout>
</LinearLayout>

<LinearLayout android:id="@+id/keyring_link_card" style="@style/KeyringCard" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="20dp" android:paddingBottom="20dp">
<ImageView style="@style/SettingsIcon" android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/s_tile_large" android:src="@drawable/ic_s_qr"/>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:orientation="vertical">
<TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Vincula tu llavero" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/senda_ink"/>
<TextView android:id="@+id/keyring_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textSize="15sp" android:textColor="@color/senda_muted"/>
</LinearLayout>
</LinearLayout>

<com.google.android.material.button.MaterialButton android:id="@+id/button_select_sensor" style="@style/AuthButton" android:layout_marginTop="10dp" android:text="@string/keyring_scan" app:icon="@drawable/ic_s_qr"/>
<com.google.android.material.button.MaterialButton android:id="@+id/button_test_ble" style="@style/OutlineButton" android:layout_marginTop="12dp" android:text="@string/keyring_test_ble" app:icon="@drawable/ic_s_bluetooth"/>
</LinearLayout>
