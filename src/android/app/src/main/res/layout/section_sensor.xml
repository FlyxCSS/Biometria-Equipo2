<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="12dp">
<TextView style="@style/AccountTitle" android:text="@string/keyring_title"/>
<TextView style="@style/AccountSubtitle" android:text="@string/keyring_subtitle"/>
<LinearLayout style="@style/AccountCard" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="24dp" android:paddingBottom="24dp">
<ImageView android:layout_width="88dp" android:layout_height="112dp" android:src="@drawable/keyring_device" android:importantForAccessibility="no"/>
<View android:layout_width="1dp" android:layout_height="100dp" android:layout_marginHorizontal="14dp" android:background="#DCD6C5"/>
<LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
<TextView android:id="@+id/keyring_status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:paddingHorizontal="10dp" android:paddingVertical="7dp" android:textSize="11sp" android:textStyle="bold" android:textColor="#1D4032" android:accessibilityLiveRegion="polite"/>
<TextView android:id="@+id/keyring_id" style="@style/SendaSectionLabel" android:textSize="25sp" android:paddingTop="8dp" android:breakStrategy="simple"/>
<TextView android:id="@+id/keyring_park" style="@style/SendaSectionText" android:textSize="14sp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:baselineAligned="false">
<LinearLayout style="@style/AccountCard" android:layout_width="0dp" android:layout_weight="1" android:layout_marginEnd="6dp" android:minHeight="100dp">
<TextView style="@style/SendaSectionLabel" android:text="Bluetooth" android:drawableStart="@drawable/home_sensor" android:drawablePadding="6dp"/>
<TextView android:id="@+id/keyring_reception" style="@style/SendaSectionText" android:textStyle="bold" android:textSize="16sp"/>
</LinearLayout>
<LinearLayout style="@style/AccountCard" android:layout_width="0dp" android:layout_weight="1" android:layout_marginStart="6dp" android:minHeight="100dp">
<TextView style="@style/SendaSectionLabel" android:text="@string/keyring_battery"/>
<TextView android:id="@+id/keyring_battery_value" style="@style/SendaSectionText" android:text="@string/keyring_battery_unknown" android:textSize="16sp"/>
</LinearLayout>
</LinearLayout>
<LinearLayout android:id="@+id/keyring_details" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<TextView android:id="@+id/text_device" style="@style/AccountDetail"/>
<TextView android:id="@+id/text_last_o3" style="@style/AccountDetail"/>
<TextView android:id="@+id/keyring_temperature_value" style="@style/AccountDetail"/>
<TextView android:id="@+id/keyring_link_date" style="@style/AccountDetail"/>
<TextView style="@style/AccountDetail" android:text="@string/keyring_firmware"/>
</LinearLayout>
<TextView android:id="@+id/keyring_hint" style="@style/SendaSectionText" android:gravity="center" android:paddingTop="20dp" android:paddingBottom="16dp"/>
<com.google.android.material.button.MaterialButton android:id="@+id/button_select_sensor" style="@style/AuthButton" android:text="@string/keyring_scan"/>
<com.google.android.material.button.MaterialButton android:id="@+id/button_test_ble" style="@style/AuthButton" android:layout_marginTop="12dp" android:text="@string/keyring_test_ble"/>
<TextView style="@style/SendaSectionText" android:text="@string/keyring_local_hint" android:textSize="12sp" android:gravity="center" android:paddingTop="12dp"/>
</LinearLayout>