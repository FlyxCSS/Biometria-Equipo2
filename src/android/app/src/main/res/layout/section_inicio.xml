<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent">
<WebView android:id="@+id/home_map" android:layout_width="match_parent" android:layout_height="match_parent" android:contentDescription="Mapa de tu ubicación y mediciones de ozono"/>

<LinearLayout android:id="@+id/home_top_controls" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="16dp">
<!-- Cabecera: avatar, saludo, parque y estado BLE -->
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/s_card_glass" android:elevation="3dp">
<FrameLayout android:id="@+id/home_avatar_button" android:layout_width="48dp" android:layout_height="48dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackgroundBorderless" android:contentDescription="Abrir perfil"><com.google.android.material.imageview.ShapeableImageView android:id="@+id/home_avatar_photo" android:layout_width="match_parent" android:layout_height="match_parent" android:src="@drawable/account_avatar" android:scaleType="centerCrop" android:importantForAccessibility="no" app:shapeAppearanceOverlay="@style/AccountAvatarShape"/><TextView android:id="@+id/home_avatar" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center" android:textColor="#FFFFFF" android:textSize="19sp" android:textStyle="bold" android:importantForAccessibility="no"/></FrameLayout>
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginStart="12dp" android:orientation="vertical">
<TextView android:id="@+id/text_account" style="@style/HomeText" android:textSize="19sp" android:textStyle="bold" android:textFontWeight="700" android:singleLine="true" android:ellipsize="end"/>
<TextView android:id="@+id/home_park" style="@style/HomeText" android:textSize="14sp" android:textColor="@color/senda_muted" android:layout_marginTop="1dp" android:singleLine="true"/>
</LinearLayout>
<TextView android:id="@+id/text_device" style="@style/Chip" android:maxWidth="150dp" android:textSize="13sp" android:ellipsize="end"/>
</LinearLayout>

<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:baselineAligned="false">
<LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="10dp">
<!-- Filtros de la capa de ozono (solo visibles con la capa activa) -->
<LinearLayout android:id="@+id/home_heat_filters" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<com.google.android.material.button.MaterialButtonToggleGroup android:id="@+id/home_period" style="@style/SegmentGroup" android:background="@drawable/s_card_glass" android:elevation="3dp" app:singleSelection="true" app:selectionRequired="true" app:checkedButton="@id/home_today">
<com.google.android.material.button.MaterialButton android:id="@+id/home_today" style="@style/RoutePeriodButton" android:text="@string/home_today"/>
<com.google.android.material.button.MaterialButton android:id="@+id/home_week" style="@style/RoutePeriodButton" android:text="@string/home_week"/>
</com.google.android.material.button.MaterialButtonToggleGroup>
<TextView android:id="@+id/home_layer_name" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="10dp" android:background="@drawable/s_card_glass" android:elevation="3dp" android:gravity="center_vertical" android:paddingStart="16dp" android:paddingEnd="14dp" android:text="@string/home_ozone" android:textSize="17sp" android:textStyle="bold" android:textColor="@color/senda_ink" android:drawableEnd="@drawable/ic_s_chevron_down"/>
</LinearLayout>
<TextView android:id="@+id/home_map_status" style="@style/HomeText" android:textSize="13sp" android:background="@drawable/s_card_glass" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="8dp" android:paddingBottom="8dp" android:layout_marginTop="10dp" android:elevation="3dp" android:accessibilityLiveRegion="polite"/>
</LinearLayout>
<!-- Controles verticales del mapa -->
<LinearLayout android:layout_width="52dp" android:layout_height="wrap_content" android:orientation="vertical" android:gravity="center_horizontal" android:paddingTop="2dp" android:paddingBottom="2dp" android:background="@drawable/s_card_glass" android:elevation="3dp">
<com.google.android.material.button.MaterialButton android:id="@+id/home_heat_toggle" style="@style/HomeMapButton" android:layout_width="48dp" android:layout_height="48dp" android:text="" app:icon="@drawable/ic_s_layers" app:iconTint="@color/senda_ink" app:iconSize="24dp" app:iconPadding="0dp" app:iconGravity="textStart" android:contentDescription="Mostrar u ocultar capa de ozono" android:checkable="true"/>
<com.google.android.material.button.MaterialButton android:id="@+id/home_recenter" style="@style/HomeMapButton" android:layout_width="48dp" android:layout_height="48dp" android:text="" android:contentDescription="@string/home_locate" app:icon="@drawable/ic_s_navigate" app:iconTint="@color/senda_ink" app:iconSize="22dp" app:iconPadding="0dp" app:iconGravity="textStart"/>
</LinearLayout>
</LinearLayout>
</LinearLayout>

<!-- Tarjeta inferior: lectura de ozono o leyenda de la capa -->
<LinearLayout android:id="@+id/home_bottom_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_gravity="bottom" android:layout_marginStart="12dp" android:layout_marginEnd="12dp" android:layout_marginBottom="104dp" android:orientation="vertical" android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="20dp" android:paddingBottom="20dp" android:background="@drawable/s_sheet" android:elevation="6dp">
<LinearLayout android:id="@+id/home_reading" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
<TextView style="@style/OverlineText" android:layout_width="0dp" android:layout_weight="1" android:text="OZONO · O₃" android:textSize="14sp"/>
<TextView android:id="@+id/home_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/senda_muted" android:drawableStart="@drawable/ic_s_sun" android:drawablePadding="6dp" android:drawableTint="@color/senda_muted" android:gravity="center_vertical"/>
</LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="2dp">
<TextView android:id="@+id/text_last_o3" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="52sp" android:textStyle="bold" android:textFontWeight="800" android:fontFamily="@font/inter_heavy" app:fontFamily="@font/inter_heavy" android:letterSpacing="-0.03" android:textColor="@color/senda_ink" android:singleLine="true"/>
<TextView android:id="@+id/home_level" style="@style/Chip" android:visibility="gone"/>
</LinearLayout>
<FrameLayout android:id="@+id/home_gauge" android:layout_width="match_parent" android:layout_height="24dp" android:layout_marginTop="6dp">
<View android:layout_width="match_parent" android:layout_height="6dp" android:layout_gravity="center_vertical" android:background="@drawable/s_gradient_o3"/>
<View android:id="@+id/home_gauge_thumb" android:layout_width="22dp" android:layout_height="22dp" android:layout_gravity="center_vertical" android:background="@drawable/s_thumb" android:visibility="invisible"/>
</FrameLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:layout_marginTop="8dp">
<TextView android:id="@+id/home_last_detail" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:textSize="15sp" android:textColor="@color/senda_muted" android:drawablePadding="8dp" android:gravity="center_vertical" android:maxLines="2"/>
<TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bueno · Alto" android:textSize="14sp" android:textColor="@color/senda_muted" android:layout_marginStart="8dp"/>
</LinearLayout>
<TextView android:id="@+id/text_o3_warning" style="@style/HomeText" android:textSize="13sp" android:textColor="@color/status_error" android:layout_marginTop="8dp" android:visibility="gone"/>
</LinearLayout>
<TextView android:id="@+id/text_route_summary" style="@style/HomeText" android:visibility="gone"/>
<TextView android:id="@+id/text_location" style="@style/HomeText" android:visibility="gone"/>
<LinearLayout android:id="@+id/home_legend" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content">
<TextView android:id="@+id/home_legend_title" style="@style/OverlineText" android:layout_width="0dp" android:layout_weight="1" android:textSize="14sp" android:text="CAPA DE OZONO · HOY"/>
<TextView android:id="@+id/home_legend_unit" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ppb" android:textSize="15sp" android:textColor="@color/senda_muted"/>
</LinearLayout>
<View android:layout_width="match_parent" android:layout_height="8dp" android:layout_marginTop="14dp" android:background="@drawable/s_gradient_o3"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp">
<TextView android:id="@+id/home_min" style="@style/HomeText" android:layout_width="0dp" android:layout_weight="1" android:textSize="15sp" android:textColor="@color/senda_muted"/>
<TextView android:id="@+id/home_mid" style="@style/HomeText" android:layout_width="0dp" android:layout_weight="1" android:gravity="center" android:textSize="15sp" android:textColor="@color/senda_muted"/>
<TextView android:id="@+id/home_max" style="@style/HomeText" android:layout_width="0dp" android:layout_weight="1" android:gravity="end" android:textSize="15sp" android:textColor="@color/senda_muted"/>
</LinearLayout></LinearLayout>
<com.google.android.material.button.MaterialButton android:id="@+id/button_start_route" style="@style/AuthButton" android:layout_marginTop="20dp" android:text="@string/main_start" app:icon="@drawable/ic_s_play"/>
</LinearLayout>
</FrameLayout>
