# Nombre: .htaccess
# Descripción: Rutas de SENDA cuando src/web es el DocumentRoot de Apache.
# Copyright: (c) 2026 Equipo 2 - SENDA / OZORA.
# Fecha: 02/11/2026
# Autor: Julia (con asistencia de Codex).
# Aportación: Enviar todas las peticiones al controlador público.
Options -Indexes
DirectoryIndex index.php
RewriteEngine On
RewriteRule ^index\.php$ - [L]
RewriteRule ^ index.php [L]
